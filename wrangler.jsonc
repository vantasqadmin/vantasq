{
  "name": "vantasq",
  "compatibility_date": "2026-09-01",
  // Only the website is published; docs, tools and agent files stay private to the repo.
  "assets": {
    "directory": "./public"
  },
  // Required by `wrangler preview` (per-PR preview URLs); empty because the site has no bindings.
  "previews": {},
  "env": {
    "staging": {
      "name": "vantasq-staging"
    }
  }
}
